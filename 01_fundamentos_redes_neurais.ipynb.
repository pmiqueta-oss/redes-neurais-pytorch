        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "# 1. Definindo a arquitetura com Forward Pass explícito\n",
        "class NeuronioForward(nn.Module):\n",
        "    def __init__(self, quantidade_entradas):\n",
        "        super(NeuronioForward, self).__init__()\n",
        "        # Camada linear: calcula (X * W) + b\n",
        "        self.camada_linear = nn.Linear(quantidade_entradas, 1)\n",
        "        # Função de ativação\n",
        "        self.ativacao = nn.Sigmoid()\n",
        "\n",
        "    def forward(self, x):\n",
        "        # Passo 1 do Forward Pass: Soma Ponderada + Viés\n",
        "        soma = self.camada_linear(x)\n",
        "        # Passo 2 do Forward Pass: Aplicação da Ativação (Sigmoide)\n",
        "        saida = self.ativacao(soma)\n",
        "        return soma, saida\n",
        "\n",
        "# 2. Instanciando o modelo\n",
        "modelo = NeuronioForward(quantidade_entradas=3)\n",
        "\n",
        "# 3. Criando o Tensor de Entrada (3 atributos para 2 amostras)\n",
        "entradas = torch.tensor([\n",
        "    [0.85, 0.30, 0.95],\n",
        "    [0.10, 0.15, 0.20]\n",
        "], dtype=torch.float32)\n",
        "\n",
        "# 4. Executando o Forward Pass\n",
        "soma_bruta, resultado_final = modelo(entradas)\n",
        "\n",
        "# 5. Exibindo os passos intermediários do Forward Pass\n",
        "print(\"--- EXECUÇÃO DO FORWARD PASS ---\")\n",
        "print(\"1. Entradas (X):\\n\", entradas)\n",
