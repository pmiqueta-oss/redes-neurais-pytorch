        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "\n",
        "# 1. Vocabulário: Mapeando cada palavra para um número (Tokenização)\n",
        "vocabulario = {\n",
        "    \"<PAD>\": 0, \"excelente\": 1, \"horrivel\": 2, \"bom\": 3,\n",
        "    \"ruim\": 4, \"produto\": 5, \"servico\": 6, \"muito\": 7\n",
        "}\n",
        "\n",
        "# 2. Dataset simples: Frases representadas por números e seus rótulos (1 = Positivo, 0 = Negativo)\n",
        "# Frase 1: \"produto excelente\" -> [5, 1] (Positivo)\n",
        "# Frase 2: \"servico horrivel\"  -> [6, 2] (Negativo)\n",
        "# Frase 3: \"muito bom\"          -> [7, 3] (Positivo)\n",
        "# Frase 4: \"muito ruim\"         -> [7, 4] (Negativo)\n",
        "\n",
        "X_texto = torch.tensor([\n",
        "    [5, 1],\n",
        "    [6, 2],\n",
        "    [7, 3],\n",
        "    [7, 4]\n",
        "], dtype=torch.long)\n",
        "\n",
        "y_sentimento = torch.tensor([[1.0], [0.0], [1.0], [0.0]], dtype=torch.float32)\n",
        "\n",
        "# 3. Criando a Rede Neural com camada de Embedding\n",
        "class ClassificadorTexto(nn.Module):\n",
        "    def __init__(self, tamanho_vocab, dim_embedding):\n",
        "        super(ClassificadorTexto, self).__init__()\n",
        "        # Embedding: Transforma números em vetores densos de significados\n",
        "        self.embedding = nn.Embedding(tamanho_vocab, dim_embedding)\n",
        "        self.camada_oculta = nn.Linear(dim_embedding, 4)\n",
        "        self.relu = nn.ReLU()\n",
        "        self.saida = nn.Linear(4, 1)\n",
        "        self.sigmoide = nn.Sigmoid()\n",
        "\n",
        "    def forward(self, x):\n",
        "        # 1. Transforma palavras em vetores e tira a média da frase\n",
        "        embeds = self.embedding(x)\n",
        "        vetor_frase = embeds.mean(dim=1)\n",
        "\n",
        "        # 2. Passa pelas camadas neurais\n",
        "        x = self.relu(self.camada_oculta(vetor_frase))\n",
        "        x = self.sigmoide(self.saida(x))\n",
        "        return x\n",
        "\n",
        "# 4. Instanciando e Treinando\n",
        "modelo_nlp = ClassificadorTexto(tamanho_vocab=len(vocabulario), dim_embedding=8)\n",
        "criterio = nn.BCELoss()\n",
        "otimizador = optim.Adam(modelo_nlp.parameters(), lr=0.05)\n",
        "\n",
        "print(\"--- TREINANDO MODELO DE NLP ---\")\n",
        "for epoca in range(1, 201):\n",
        "    previsoes = modelo_nlp(X_texto)\n",
        "    perda = criterio(previsoes, y_sentimento)\n",
        "\n",
        "    otimizador.zero_grad()\n",
        "    perda.backward()\n",
        "    otimizador.step()\n",
        "\n",
        "    if epoca % 50 == 0:\n",
        "        print(f\"Época {epoca}/200 - Perda: {perda.item():.4f}\")\n",
