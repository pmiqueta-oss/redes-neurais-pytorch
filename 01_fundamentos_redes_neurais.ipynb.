        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "\n",
        "# 1. Definição do Modelo de Classificação de Crédito\n",
        "class ClassificadorBomPagador(nn.Module):\n",
        "    def __init__(self, quantidade_atributos):\n",
        "        super(ClassificadorBomPagador, self).__init__()\n",
        "        # Camada linear com 3 entradas e 1 saída\n",
        "        self.camada_linear = nn.Linear(quantidade_atributos, 1)\n",
        "        # Função de ativação Sigmoide (retorna probabilidade entre 0 e 1)\n",
        "        self.ativacao = nn.Sigmoid()\n",
        "\n",
        "    def forward(self, x):\n",
        "        z = self.camada_linear(x)\n",
        "        probabilidade = self.ativacao(z)\n",
        "        return probabilidade\n",
        "\n",
        "# 2. Dados de Exemplo (Normalizados entre 0 e 1)\n",
        "# Atributos: [Renda Mensal, Relação Dívida/Renda, Histórico de Pontualidade]\n",
        "X_clientes = torch.tensor([\n",
        "    [0.85, 0.15, 0.95],  # Cliente 1: Renda alta, baixa dívida, ótimo histórico -> (Bom Pagador)\n",
        "    [0.20, 0.80, 0.30],  # Cliente 2: Renda baixa, alta dívida, histórico ruim -> (Mau Pagador)\n",
        "    [0.70, 0.35, 0.80],  # Cliente 3: Perfil equilibrado -> (Bom Pagador)\n",
        "    [0.30, 0.70, 0.20]   # Cliente 4: Alto risco -> (Mau Pagador)\n",
        "], dtype=torch.float32)\n",
        "\n",
        "# Rótulos Reais (1 = Bom Pagador, 0 = Mau Pagador)\n",
        "y_real = torch.tensor([[1.0], [0.0], [1.0], [0.0]], dtype=torch.float32)\n",
        "\n",
        "# 3. Configuração do Modelo, Perda e Otimizador\n",
        "modelo = ClassificadorBomPagador(quantidade_atributos=3)\n",
        "criterio = nn.BCELoss()  # Binary Cross Entropy Loss\n",
        "otimizador = optim.SGD(modelo.parameters(), lr=0.2)\n",
        "\n",
        "# 4. Treinamento da Rede Neural\n",
        "print(\"--- TREINANDO O CLASSIFICADOR DE CRÉDITO ---\")\n",
