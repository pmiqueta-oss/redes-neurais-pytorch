        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "\n",
        "# 1. Vocabulário para o Módulo de Texto (NLP)\n",
        "vocabulario = {\n",
        "    \"<PAD>\": 0, \"<UNK>\": 1, \"dígito\": 2, \"numero\": 3, \"um\": 4,\n",
        "    \"sete\": 5, \"nove\": 6, \"bonito\": 7, \"feio\": 8, \"certo\": 9, \"errado\": 10\n",
        "}\n",
        "\n",
        "def texto_para_tensor(texto, max_len=6):\n",
        "    palavras = texto.lower().split()\n",
        "    indices = [vocabulario.get(p, vocabulario[\"<UNK>\"]) for p in palavras]\n",
        "    if len(indices) < max_len:\n",
        "        indices += [vocabulario[\"<PAD>\"]] * (max_len - len(indices))\n",
        "    return torch.tensor(indices[:max_len], dtype=torch.long)\n",
        "\n",
        "# 2. Arquitetura da Rede Neural para NLP (Embedding + Classificação)\n",
        "class ClassificadorTexto(nn.Module):\n",
        "    def __init__(self, tamanho_vocab, dim_embedding=16, num_classes=2):\n",
        "        super(ClassificadorTexto, self).__init__()\n",
        "        self.embedding = nn.Embedding(tamanho_vocab, dim_embedding, padding_idx=0)\n",
        "        self.fc1 = nn.Linear(dim_embedding, 32)\n",
        "        self.relu = nn.ReLU()\n",
        "        self.fc2 = nn.Linear(32, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # Transforma os índices em vetores e calcula a média das palavras da frase\n",
        "        emb = self.embedding(x)\n",
        "        vetor_medio = emb.mean(dim=1)\n",
        "        x = self.relu(self.fc1(vetor_medio))\n",
        "        return self.fc2(x)\n",
        "\n",
        "# 3. Dados de Treinamento Simulado (0 = Validação Negativa, 1 = Validação Positiva)\n",
        "frases = [\n",
        "    \"dígito bonito certo\",\n",
        "    \"numero sete bonito\",\n",
        "    \"dígito feio errado\",\n",
        "    \"numero um errado\"\n",
        "]\n",
        "labels = torch.tensor([1, 1, 0, 0], dtype=torch.long)\n",
        "\n",
        "X_texto = torch.stack([texto_para_tensor(f) for f in frases])\n",
        "\n",
        "# 4. Instanciando e Treinando\n",
        "modelo_nlp = ClassificadorTexto(len(vocabulario))\n",
        "criterio_nlp = nn.CrossEntropyLoss()\n",
        "otimizador_nlp = optim.Adam(modelo_nlp.parameters(), lr=0.01)\n",
        "\n",
        "print(\"--- TREINANDO MODELO DE NLP (TEXTO) ---\")\n",
        "for epoca in range(1, 51):\n",
        "    otimizador_nlp.zero_grad()\n",
        "    saidas = modelo_nlp(X_texto)\n",
        "    perda = criterio_nlp(saidas, labels)\n",
        "    perda.backward()\n",
        "    otimizador_nlp.step()\n",
        "\n",
        "print(\"Treinamento de NLP Concluído com Sucesso! ✅\")\n",
        "\n",
        "# 5. Teste com nova descrição\n",
        "nova_descricao = \"numero bonito certo\"\n",
        "tensor_teste = texto_para_tensor(nova_descricao).unsqueeze(0)\n",
        "\n",
        "modelo_nlp.eval()\n",
        "with torch.no_grad():\n",
        "    pred = modelo_nlp(tensor_teste)\n",
        "    prob = torch.softmax(pred, dim=1)\n",
        "    status = \"DESCRIÇÃO VÁLIDA ✅\" if torch.argmax(prob) == 1 else \"DESCRIÇÃO INVÁLIDA ❌\"\n",
        "\n",
        "print(f\"\\nTeste na frase: '{nova_descricao}'\")\n",
        "print(f\"Resultado: {status} ({prob[0][1].item()*100:.2f}% de confiança)\")"
